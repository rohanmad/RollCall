EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_INVITE_URL=https://rollcall.app/invite

# Optional: OpenAI vision for smarter memory titles + cover picks.
# Without this key, RollCall keeps the local heuristic pipeline.
# Note: EXPO_PUBLIC_ keys ship in the client bundle — fine for demos;
# proxy through a backend for production.
EXPO_PUBLIC_OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
# EXPO_PUBLIC_OPENAI_VISION_MODEL=gpt-4o-mini

# After filling Supabase keys, run supabase/schema.sql in the SQL editor
# (creates profiles, memories, friends, engagement, notifications, storage).
